# Variables de entorno — copia a .env (para `netlify dev`) y configúralas también en Netlify.
# Las VITE_* son públicas (se inyectan en el build, protegidas por RLS).
# GROQ_API_KEY y SUPABASE_SERVICE_ROLE_KEY son SECRETAS: solo en Netlify Functions.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://TU-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...

# Groq (https://console.groq.com/keys) — SECRETA
GROQ_API_KEY=gsk_...

# Supabase service_role (Project Settings → API) — SECRETA, solo servidor
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
